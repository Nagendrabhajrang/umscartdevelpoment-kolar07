# =============================================================================
# UMS Mart - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) --------------------------------------------------
DB_NAME=ums_mart_db
DB_USER=ums_mart_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# --- Authentication: single admin account -----------------------------------
# Used only by `python manage.py create_admin`. There is no public admin
# registration endpoint; the account is provisioned from the command line.
ADMIN_EMAIL=nagendrajoe@gmail.com

# --- JWT (SimpleJWT) --------------------------------------------------------
# Lifetimes are in minutes; refresh is 7 days by default.
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# --- OTP policy -------------------------------------------------------------
OTP_LENGTH=6
OTP_VALIDITY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20

# --- Development convenience ------------------------------------------------
# When true AND DEBUG is true, auth responses include the OTP as `dev_otp` so
# flows can be tested without a mail or SMS provider. Has no effect when
# DEBUG=False, so it is safe to leave in a local file. NEVER enable in prod.
AUTH_DEV_MODE=True

# --- Email delivery (admin MFA + password reset OTPs) -----------------------
# Resend is used when an API key is present. Without one, and with
# EMAIL_CONSOLE_FALLBACK on, the message is logged to the console instead.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=UMS Mart <no-reply@yourdomain.com>
EMAIL_CONSOLE_FALLBACK=True

# --- SMS delivery (customer OTPs) ------------------------------------------
# 2Factor.in. REQUIRED for real customer OTPs. Without a key nothing is sent:
# `send-otp` returns delivered=false and, with AUTH_DEV_MODE on, the code in the
# response. See docs/otp-delivery-setup.md.
TWOFACTOR_API_KEY=
TWOFACTOR_BASE_URL=https://2factor.in/API/V1
TWOFACTOR_SENDER_ID=

# --- Misc -------------------------------------------------------------------
API_PAGE_SIZE=20
MAX_UPLOAD_SIZE_MB=10
PASSWORD_MIN_LENGTH=8
