# Base URL of the UMS Mart Django API.
# Leave relative to use the Vite dev proxy (recommended for local development).
VITE_API_BASE_URL=/api/v1
# Identity header used until the authentication phase ships. Do NOT deploy
# this build publicly - see docs/AUTHENTICATION.md in the backend.
VITE_DEFAULT_CUSTOMER_ID=1
VITE_STORE_NAME=UMS Mart
