# UMS Mart - local development on Windows.
# No quotes, no spaces around '='. Restart runserver after any change.
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
# 10.0.2.2 is how the Android emulator reaches this PC.
# For a real phone, add your PC's Wi-Fi address to the end of this line.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DB_NAME=ums_mart_databaseadmin
DB_USER=ums_mart_useradminums
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

ADMIN_EMAIL=admin@example.com

AUTH_DEV_MODE=True
EMAIL_CONSOLE_FALLBACK=True

OTP_LENGTH=6
OTP_VALIDITY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=50
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=200

API_PAGE_SIZE=20
MAX_UPLOAD_SIZE_MB=10
PASSWORD_MIN_LENGTH=8
