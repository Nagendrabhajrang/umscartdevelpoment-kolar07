##############################################################################
# UMS Mart - environment template
#
# Copy this file to `backend/.env` and fill in real values:
#
#     cp .env.example backend/.env        # Linux / macOS
#     copy .env.example backend\.env      # Windows (cmd)
#
# NEVER commit the real .env file. `.gitignore` already excludes it.
# Every variable below is optional unless marked REQUIRED.
##############################################################################

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-unique-64-char-secret

# One of: config.settings.development | config.settings.production
# Also accepted as DJANGO_SETTINGS_MODULE when running manage.py directly.
DJANGO_SETTINGS_MODULE=config.settings.development

# REQUIRED in production: comma-separated host names the API answers on.
# Example: api.umsmart.com,www.umsmart.com,203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True only while debugging. MUST be False in production.
DEBUG=True

TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database (PostgreSQL - SQLite is not supported for this project)
# ---------------------------------------------------------------------------
# Use EITHER a full DATABASE_URL...
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
#
# ...OR the individual variables below. Do not set both: DATABASE_URL wins and
# silently overrides every DB_* line (config/settings/base.py checks it after
# the discrete values). If your credentials seem to be ignored, you have a
# DATABASE_URL set - delete that line.
DB_NAME=ums_mart_db
DB_USER=ums_mart_user
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=5432

# Used by the test runner only; defaults to test_<DB_NAME>.
DB_TEST_NAME=test_ums_mart_db
# Persistent connections (0 = close after each request). Use 60 in production.
DB_CONN_MAX_AGE=0
# Seconds to wait before giving up on a new connection.
DB_CONNECT_TIMEOUT=10
# SQL logging threshold: DEBUG | INFO | WARNING
DB_LOG_LEVEL=WARNING

# ---------------------------------------------------------------------------
# Static and media files
# ---------------------------------------------------------------------------
# NOTE: STATIC_ROOT and MEDIA_ROOT are NOT read from this file. They are fixed
# relative to the code in config/settings/base.py:
#
#     <repo>/backend/staticfiles   and   <repo>/backend/media
#
# so the project works from any install path with no edits.
STATIC_URL=/static/
MEDIA_URL=/media/
# Reject uploads larger than this (product images, payment screenshots).
MAX_UPLOAD_SIZE_MB=5

# ---------------------------------------------------------------------------
# CORS / CSRF (the future customer web + admin front-ends)
# ---------------------------------------------------------------------------
# The dev servers proxy /api to :8000, so you normally need NOTHING here.
# Development settings already allow all origins by default. Only set these
# when you serve a built front end from a different host.
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Email (password resets, order confirmations)
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UMS Mart <no-reply@umsmart.local>
SERVER_EMAIL=UMS Mart Errors <errors@umsmart.local>
ADMIN_EMAIL=admin@umsmart.local

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------
# Default page size for every list endpoint.
API_PAGE_SIZE=20
# DRF throttling rates, e.g. 100/hour. Keep the anon rate tighter.
THROTTLE_ANON_RATE=1000/hour
THROTTLE_USER_RATE=10000/hour
# Require a staff session to open /api/docs/ and /api/schema/ in production.
DOCS_REQUIRE_ADMIN=True

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Directory for rotating log files (production settings only).
# Defaults to <repo>/backend/logs and is created automatically if missing.
# LOG_DIR=

# ---------------------------------------------------------------------------
# Security toggles (production only - all are ignored in development)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_AGE=1209600

# Optional Django Debug Toolbar in development.
USE_DEBUG_TOOLBAR=False
